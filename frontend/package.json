{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/compile-help.mjs --if-present && tsc -b && vite build",
    "lint": "oxlint && node scripts/check-design-tokens.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "help:compile": "node scripts/compile-help.mjs",
    "help:check": "node scripts/compile-help.mjs --check",
    "help:diagrams": "node scripts/render-help-diagrams.mjs",
    "help:inventory": "node scripts/help-inventory.mjs",
    "help:walkthrough": "node e2e/help-walkthrough.mjs",
    "postbuild": "node scripts/check-bundle.mjs",
    "pretest": "node scripts/compile-help.mjs --if-present"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "minisearch": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "hast-util-to-string": "^3.0.1",
    "jsdom": "^29.1.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "~6.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
