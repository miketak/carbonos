{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "procedure": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "after": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "let": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "title": {
            "type": "string"
          },
          "intro": {
            "type": "string"
          },
          "cases": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z]\\d+$"
                },
                "title": {
                  "type": "string"
                },
                "steps": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "as": {
                        "type": "string"
                      },
                      "do": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      },
                      "expect": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        }
                      },
                      "capture": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "why": {
                        "type": "string"
                      },
                      "continueOnFail": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "title",
                "steps"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "cases"
        ],
        "additionalProperties": false
      }
    },
    "docs": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "estimatedMinutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "objective": {
          "type": "string"
        },
        "coversText": {
          "type": "string"
        },
        "runNote": {
          "type": "string"
        },
        "prerequisitesText": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knownNonGoals": {
          "type": "string"
        },
        "rationale": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "changeNotes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "date": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "version",
              "date",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "estimatedMinutes",
        "objective"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "procedure",
    "slug",
    "title",
    "covers",
    "sections",
    "docs"
  ],
  "additionalProperties": false
}
